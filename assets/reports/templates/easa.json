          { "text": "REGISTRATION", "weight": "bold" },
          { "text": "SEL", "weight": "bold" },
          { "text": "MEL", "weight": "bold" },
          { "text": "D\nA\nY", "weight": "bold" },
          { "text": "N\nI\nG\nH\nT", "weight": "bold" },
          { "text": "D\nA\nY", "weight": "bold" },
          { "text": "N\nI\nG\nH\nT", "weight": "bold" }
