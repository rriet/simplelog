{
  "rowsPerPage": 27,
  "forceLandscape": true,
  "defaultPageSize": "letter",
  "dateFormat": "dd-MMM-yyyy",
  "timeFormat": "H:mm",
  "rowHeight": 16,
  "alternateRowBackgroundColor": "#E6E8EB",
  "coverPageImport": "cover_page_default",
  "labels": {
    "pageTotal": "PAGE TOTAL",
    "amountForward": "AMT. FORWARD",
    "totalToDate": "TOTAL TO DATE"
  },
  "tables": [
    {
      "pageSuffix": "A",
      "header": [
        {
          "rowHeight": 14,
          "cells": [
            { "text": "DATE\n(DD/MM/YYYY)", "vspan": 2, "weight": "bold" },
            { "text": "AIRCRAFT\nMAKE AND MODEL", "vspan": 2, "weight": "bold" },
            { "text": "AIRCRAFT\nIDENT", "vspan": 2, "weight": "bold" },
            {
              "text": "POINTS OF DEPARTURE AND ARRIVAL",
              "hspan": 2,
              "weight": "bold"
            },
            {
              "text": "REMARKS, PROCEDURES, MANEUVERS",
              "hspan": 2,
              "vspan": 2,
              "weight": "bold"
            },
            { "text": "NO.\nINSTR.\nAPP.", "vspan": 2, "weight": "bold" },
            { "text": "NO.\nLDG.", "vspan": 2, "weight": "bold" }
          ]
        },
        {
          "rowHeight": 12,
          "cells": [
            { "text": "FROM", "weight": "bold" },
            { "text": "TO", "weight": "bold" }
          ]
        }
      ],
      "columns": [
        { "key": "entryDate", "width": 1.0 },
        { "key": "entryType", "width": 1.2 },
        { "key": "entryRegistration", "width": 1.25 },
        { "key": "fromIcao", "width": 1.25 },
        { "key": "toIcao", "width": 1.25 },
        {
          "key": "anySignature",
          "width": 0.9,
          "signatureWidth": 16,
          "signatureHeight": 6,
          "signatureShowBorder": false
        },
        { "key": "anyRemarks", "width": 4.6, "alignment": "left" },
        { "key": "ifrApproaches", "width": 0.75 },
        { "key": "landingsTotal", "width": 0.75 }
      ],
      "footerRows": [
        {
          "source": "pageTotals",
          "cells": [
            {
              "text": "I certify that statements made by me in this log book are true.",
              "vspan": 3,
              "hspan": 6,
              "align": "center",
              "valign": "middle",
              "fontSize": 5.8,
              "imageToken": "pilot.signatureImage",
              "imageBelowText": true,
              "imageWidth": 100,
              "imageHeight": 30,
              "imageShowBorder": false
            },
            { "text": "PAGE TOTAL", "weight": "bold", "align": "left" },
            { "key": "ifrApproaches", "weight": "bold" },
            { "valueToken": "landings", "weight": "bold" }
          ]
        },
        {
          "source": "totalsBefore",
          "cells": [
            { "text": "AMT. FORWARD", "weight": "bold", "align": "left" },
            { "key": "ifrApproaches", "weight": "bold" },
            { "valueToken": "landings", "weight": "bold" }
          ]
        },
        {
          "source": "totalsAfter",
          "cells": [
            { "text": "TOTAL TO DATE", "weight": "bold", "align": "left" },
            { "key": "ifrApproaches", "weight": "bold" },
            { "valueToken": "landings", "weight": "bold" }
          ]
        }
      ]
    },
    {
      "pageSuffix": "B",
      "header": [
        {
          "rowHeight": 10,
          "cells": [
            { "text": "AIRCRAFT CATEGORY", "hspan": 2, "weight": "bold" },
            { "text": "CROSS-\nCOUNTRY", "vspan": 2, "weight": "bold" },
            { "text": "CONDITIONS OF FLIGHT", "hspan": 5, "weight": "bold" },
            { "text": "TYPE OF PILOTING TIME", "hspan": 4, "weight": "bold" },
            { "text": "TOTAL\nDURATION\nOF FLIGHT", "vspan": 2, "weight": "bold" }
          ]
        },
        {
          "rowHeight": 16,
          "cells": [
            { "text": "AIRPLANE\nSEL", "weight": "bold" },
            { "text": "AIRPLANE\nMEL", "weight": "bold" },
            { "text": "DAY", "weight": "bold" },
            { "text": "NIGHT", "weight": "bold" },
            { "text": "ACTUAL\nINSTRUMENT", "weight": "bold" },
            { "text": "SIMULATED\nINSTRUMENT", "weight": "bold" },
            { "text": "SIMULATOR", "weight": "bold" },
            { "text": "DUAL\nRECEIVED", "weight": "bold" },
            { "text": "PILOT-IN-\nCOMMAND", "weight": "bold" },
            { "text": "SECOND-IN-\nCOMMAND", "weight": "bold" },
            { "text": "FLIGHT\nINSTRUCTOR", "weight": "bold" }
          ]
        }
      ],
      "columns": [
        { "key": "sel", "width": 0.9 },
        { "key": "mel", "width": 0.9 },
        { "key": "xc", "width": 0.9 },
        { "key": "day", "width": 0.9 },
        { "key": "night", "width": 0.9 },
        { "key": "ifr", "width": 0.9 },
        { "key": "simInst", "width": 0.9 },
        { "key": "fstd", "width": 0.9 },
        { "key": "dual", "width": 0.9 },
        { "key": "pic", "width": 0.9 },
        { "key": "sic", "width": 0.9 },
        { "key": "instructor", "width": 0.9 },
        { "key": "total", "width": 0.9 }
      ],
      "footerRows": [
        {
          "labelToken": "pageTotal",
          "source": "pageTotals",
          "values": {
            "sel": "sel",
            "mel": "mel",
            "xc": "xc",
            "day": "day",
            "night": "night",
            "ifr": "ifr",
            "simInst": "simInst",
            "fstd": "fstd",
            "dual": "dual",
            "pic": "pic",
            "sic": "sic",
            "instructor": "instructor",
            "total": "total"
          }
        },
        {
          "labelToken": "amountForward",
          "source": "totalsBefore",
          "values": {
            "sel": "sel",
            "mel": "mel",
            "xc": "xc",
            "day": "day",
            "night": "night",
            "ifr": "ifr",
            "simInst": "simInst",
            "fstd": "fstd",
            "dual": "dual",
            "pic": "pic",
            "sic": "sic",
            "instructor": "instructor",
            "total": "total"
          }
        },
        {
          "labelToken": "totalToDate",
          "source": "totalsAfter",
          "values": {
            "sel": "sel",
            "mel": "mel",
            "xc": "xc",
            "day": "day",
            "night": "night",
            "ifr": "ifr",
            "simInst": "simInst",
            "fstd": "fstd",
            "dual": "dual",
            "pic": "pic",
            "sic": "sic",
            "instructor": "instructor",
            "total": "total"
          }
        }
      ]
    }
  ]
}
