{
  "displayName": "Standard - Jeppesen",
  "rowsPerPage": 27,
  "forceLandscape": true,
  "defaultPageSize": "letter",
  "rowHeight": 11,
  "coverPage": {
    "enabled": true,
    "title": "Pilot Logbook Summary",
    "blocks": [
      {
        "type": "kvGrid",
        "title": "Pilot details",
        "columns": 2,
        "items": [
          { "label": "Name", "valueKey": "pilot.name" },
          { "label": "Licence number", "valueKey": "pilot.licenceNumber" },
          { "label": "Address", "valueKey": "pilot.address" },
          { "label": "From", "valueKey": "report.fromDate" },
          { "label": "To", "valueKey": "report.toDate" }
        ]
      }
    ]
  },
  "labels": {
    "pageTotal": "PAGE TOTAL",
    "amountForward": "AMT. FORWARD",
    "totalToDate": "TOTAL TO DATE"
  },
  "tables": [
    {
      "pageSuffix": "A",
      "header": [
        [
          { "text": "Date", "weight": "bold" },
          { "text": "Model", "weight": "bold" },
          { "text": "Reg", "weight": "bold" },
          { "text": "From", "weight": "bold" },
          { "text": "To", "weight": "bold" },
          { "text": "Remarks", "weight": "bold", "align": "TopLeft" },
          { "text": "APP", "weight": "bold" },
          { "text": "LDG", "weight": "bold" },
          { "text": "XC", "weight": "bold" }
        ]
      ],
      "columns": [
        { "key": "date", "width": 1.1 },
        { "key": "aircraftModel", "width": 1.2 },
        { "key": "aircraftRegistration", "width": 1.1 },
        { "key": "fromIcao", "width": 0.9 },
        { "key": "toIcao", "width": 0.9 },
        { "key": "remarks", "width": 2.6, "alignment": "left" },
        { "key": "ifrApproaches", "width": 0.8 },
        { "key": "landingsTotal", "width": 0.8 },
        { "key": "xc", "width": 0.9 }
      ],
      "footerRows": [
        {
          "labelToken": "pageTotal",
          "source": "pageTotals",
          "values": {
            "landingsTotal": "landings"
          }
        },
        {
          "labelToken": "amountForward",
